 // SPDX-License-Identifier: MIT
 
-// SPDX-FileCopyrightText: 2020-2023 Stefan Schmidt
+// SPDX-FileCopyrightText: 2020-2024 Stefan Schmidt
 // SPDX-FileCopyrightText: 2021 Lucas Jansson
 
+#include <assert.h>
 #include <excpt.h>
